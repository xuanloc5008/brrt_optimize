<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="odom_topic" value="/visual_slam/odom" />
  <arg name="global_env_pcd2_topic" value="/random_forest/all_map" />

  <arg name="simulation" default="true"/>
  <arg name="drone_number" default="1"/>

  <arg name="map_size_x" default="1000.0"/>
  <arg name="map_size_y" default="1000.0"/>
  <arg name="map_size_z" default="1.5"/>
  <arg name="obs_num" default="5000"/>
  <arg name="circle_num" default="5000"/>
  <arg name="ground_obstacle_probability" default="0.5"/>
  <!-- Map types: random_large, narrow, rooms, blobs, flappy, u_shaped,
                  maze_dfs, l_shape_grid, random_narrow, env_v_shape, etc. -->
  <arg name="map_type" default="random_large"/>
  <!-- map_resolution: point-cloud density fed to the occupancy grid.
       0.5 matches the occupancy grid resolution — no information is lost
       and the point count stays manageable even on large maps.
       Use 0.1 only for very small maps or when you need high visual detail. -->
  <arg name="map_resolution" default="0.5"/>

  <arg name="init_x" value="0.0"/>
  <arg name="init_y" value="0.0"/>
  <arg name="init_z" value="0.0"/>

  <arg name="forest" value="1"/>

  <!-- map generation -->
  <!-- env for front-end compare-->
  <node pkg="map_generator" name="random_forest" type="random_forest" output="screen" if="$(arg forest)">
    <remap from="~odometry" to="$(arg odom_topic)"/>
    <param name="init_state_x" value="$(arg init_x)"/>
    <param name="init_state_y" value="$(arg init_y)"/>
    <param name="map/x_size" value="$(arg map_size_x)" />
    <param name="map/y_size" value="$(arg map_size_y)" />
    <param name="map/z_size" value="$(arg map_size_z)" />
    <param name="map/obs_num" value="$(arg obs_num)"/>
    <param name="map/ground_obstacle_probability" value="$(arg ground_obstacle_probability)"/>
    <param name="map/circle_num" value="$(arg circle_num)"/>
    <param name="map/map_type" value="$(arg map_type)"/>
    <param name="map/resolution" value="$(arg map_resolution)"/>
    <param name="ObstacleShape/lower_rad" value="0.4"/>
    <param name="ObstacleShape/upper_rad" value="2.5"/>
    <param name="ObstacleShape/lower_hei" value="0.5"/>
    <param name="ObstacleShape/upper_hei" value="7.5"/>
    <param name="CircleShape/lower_circle_rad" value="0.9"/>
    <param name="CircleShape/upper_circle_rad" value="3.2"/>
    <param name="sensing/rate" value="1.0"/>
  </node>
  <include file="$(find mockamap)/launch/mockamap.launch" unless="$(arg forest)"/>

</launch>